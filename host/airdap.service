[Unit]
Description=AirDAP local USB/IP and device management service
After=network-online.target bluetooth.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/airdap
ExecStart=/opt/airdap/.venv/bin/python /opt/airdap/host/airdap-service.py --data-dir /var/lib/airdap
Restart=on-failure
RestartSec=10
TimeoutStopSec=600
UMask=0077
StateDirectory=airdap
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/airdap /run /sys/devices/platform
# usbip attach/detach requires VHCI sysfs access; physical USB also needs /dev/bus/usb.

[Install]
WantedBy=multi-user.target
