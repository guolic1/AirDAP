menu "AirDAP USB device"

    config AIRDAP_DEBUG_SHELL
        bool "Enable the USB Vendor Bulk debug shell"
        default n
        select FREERTOS_GENERATE_RUN_TIME_STATS
        select FREERTOS_VTASKLIST_INCLUDE_COREID if !FREERTOS_SMP
        help
            Add a Vendor-specific Bulk interface for AirDAP firmware
            diagnostics. The shell provides detailed read-only system, heap,
            mode, OTA, target, and FreeRTOS task diagnostics, along with Wi-Fi
            credential management, BOOT_KEY simulation, and restart commands.
            Simulating BOOT_KEY can open BLE provisioning or clear network
            configuration and restart the device. The shell also mirrors ESP
            logs after the host starts a session. Enabling the shell collects
            FreeRTOS task run-time statistics and includes task core affinity.
            Set TinyUSB Vendor Interface Count to 2 when enabling this option.
            The checked-in sdkconfig.defaults profile sets the interface count
            and uses a 64-bit run-time counter for reproducible standard builds.

endmenu
